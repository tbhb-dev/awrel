{
  "language": "en",
  "ignorePaths": [
    ".mise/**/*",
    ".rumdl_cache/**/*",
    ".vale/**/*",
    ".venv/**/*",
    ".bazel-*/**/*",
    "bazel-*/**/*",
    "coverage.xml",
    "go.sum",
    "LICENSE",
    "MODULE.bazel.lock",
    "mise.lock",
    "pnpm-lock.yaml",
    "tmp/**/*",
    "tools/testdata/**/*",
    "uv.lock",
    "worker-configuration.d.ts"
  ],
  "dictionaryDefinitions": [
    {
      "name": "awrel",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["awrel", "golang", "python"]
}
