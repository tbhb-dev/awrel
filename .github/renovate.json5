{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#f9315a4e0e1618cf328e5afa4b1f63b53a51c4ef", // main
    "github>tbhb-dev/renovate-config//bazel.json5#f9315a4e0e1618cf328e5afa4b1f63b53a51c4ef", // main
    "github>tbhb-dev/renovate-config//cloudflare-worker.json5#f9315a4e0e1618cf328e5afa4b1f63b53a51c4ef", // main
    "github>tbhb-dev/renovate-config//go.json5#f9315a4e0e1618cf328e5afa4b1f63b53a51c4ef", // main
    "github>tbhb-dev/renovate-config//python.json5#f9315a4e0e1618cf328e5afa4b1f63b53a51c4ef", // main
  ],

  // awrel needs nothing beyond the presets: its Go module, Bazel pins and uv
  // lock are all covered there.
}
