# gazelle:prefix go.tbhb.dev/awrel

exports_files([
    ".golangci.yml",
    "go.mod",
])

gazelle(name = "gazelle")

# Generates preset.bazelrc, which .bazelrc imports. The content depends on the
# Bazel version that runs the generator; the committed copy matches
# .bazelversion, and `preset.update_test` fails when it is stale.
bazelrc_preset(
    name = "preset",
)

# buildifier: `//:buildifier` formats and applies lint fixes in place,
# `//:buildifier.check` fails on any formatting or lint difference, and the
# test below makes `bazel test //...` fail on the same findings. Every
# available warning is on. `.bazel-*` and `bazel-*` convenience symlinks, the
# Python and tool caches and scratch space hold no Starlark that this repository
# owns.
BUILDIFIER_EXCLUDES = [
    "./.git/*",
    "./.venv/*",
    "./.mise/*",
    "./.bazel-*",
    "./bazel-*",
    "./node_modules/*",
    "./tmp/*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    lint_warnings = ["all"],
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    mode = "diff",
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

# The vet subset that is accurate enough to fail a build: atomic, bools,
# buildtag, nilfunc, and printf.
nogo(
    name = "nogo",
    vet = True,
    visibility = ["//visibility:public"],
)

# The Go checks, over every binary and test of the module. golangci-lint runs
# per package as an aspect, over export data, and fails if any Go file of the
# tree is never linted. deadcode takes every binary at once, so a function only
# one binary calls is live. go-arch-lint holds the import contracts in
# .go-arch-lint.yml, and go mod tidy checks go.mod and go.sum offline against
# the module proxy.
GO_TARGETS = [
    "//cmd/awrel",
    "//cmd/awrel:awrel_test",
    "//internal/buildmeta:buildmeta_test",
    "//internal/compact:compact_test",
    "//internal/delivery:delivery_test",
    "//internal/mcpserver:mcpserver_test",
    "//internal/persist:persist_test",
    "//internal/protocol:protocol_test",
    "//internal/relayclient:relayclient_test",
    "//internal/transport:transport_test",
]

golangci_lint_test(
    name = "golangci_lint_test",
    srcs = GO_TARGETS,
    expect_linted = [":repo_files"],
)

go_deadcode_test(
    name = "go_deadcode_test",
    srcs = GO_TARGETS,
)

go_arch_lint_test(
    name = "go_arch_lint_test",
    srcs = GO_TARGETS,
    config = ".go-arch-lint.yml",
    go_mod = "go.mod",
)

go_mod_tidy_test(
    name = "go_mod_tidy_test",
    srcs = [":repo_files"],
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
)

# Reachable vulnerabilities in the module's dependencies and the standard
# library, against the Go vulnerability database. The database comes over the
# network, so the test is manual and outside `//...`; run it by name.
govulncheck_test(
    name = "govulncheck_test",
    srcs = GO_TARGETS,
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
)

# The `bazel run` companion of the same scan, which CI runs, keeping
# its report as an artifact.
govulncheck(
    name = "govulncheck",
    srcs = GO_TARGETS,
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
)

# Mutation testing: every mutant gomutants makes of a package must be killed
# by that package's tests. One cached run per package; by default every
# package runs in full. For a diff-scope run, write the changes since a base
# and point the flag at them:
#
#   bazel run @tbhb_rules//quality:mutation_changes -- --base origin/main --out .mutation/changes.json
#   bazel test --@tbhb_rules//quality:changes=//:mutation_changes //:gomutants_test //:gomutants_persist_test
gomutants_test(
    name = "gomutants_test",
    cpus = 2,
    data = ["//internal/compact:testdata"],
    flags = [
        "--exclude-calls=*.DebugContext,*.InfoContext,*.WarnContext,*.ErrorContext",
        # A mutant that breaks a wait takes the tests' own one-second limits
        # to fail, so the 2s default floor would count it as a timeout.
        "--timeout-min=20s",
        "--test-flags=-failfast",
    ],
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
    tests = [
        "//cmd/awrel:awrel_test",
        "//internal/buildmeta:buildmeta_test",
        "//internal/compact:compact_test",
        "//internal/delivery:delivery_test",
        "//internal/mcpserver:mcpserver_test",
        "//internal/protocol:protocol_test",
        "//internal/relayclient:relayclient_test",
        "//internal/transport:transport_test",
    ],
)

gomutants_test(
    name = "gomutants_persist_test",
    cpus = 2,
    data = ["//internal/compact:testdata"],
    flags = [
        "--exclude-calls=*.DebugContext,*.InfoContext,*.WarnContext,*.ErrorContext",
        # A mutant that breaks a wait takes the tests' own one-second limits
        # to fail, so the 2s default floor would count it as a timeout.
        "--timeout-min=20s",
        "--test-flags=-failfast",
    ],
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tests = ["//internal/persist:persist_test"],
)

# Condition coverage: every condition of a package reaches both outcomes, as
# gobco measures it. One target per package, because gobco instruments one
# package per run. The requirement is fixed at 100%.
gobco_test(
    name = "awrel_gobco_test",
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
    tests = ["//cmd/awrel:awrel_test"],
)

gobco_test(
    name = "buildmeta_gobco_test",
    go_mod = "go.mod",
    go_sum = "go.sum",
    tests = ["//internal/buildmeta:buildmeta_test"],
)

gobco_test(
    name = "compact_gobco_test",
    data = ["//internal/compact:testdata"],
    go_mod = "go.mod",
    go_sum = "go.sum",
    tests = ["//internal/compact:compact_test"],
)

gobco_test(
    name = "delivery_gobco_test",
    go_mod = "go.mod",
    go_sum = "go.sum",
    tests = ["//internal/delivery:delivery_test"],
)

gobco_test(
    name = "mcpserver_gobco_test",
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
    tests = ["//internal/mcpserver:mcpserver_test"],
)

gobco_test(
    name = "persist_gobco_test",
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tests = ["//internal/persist:persist_test"],
)

gobco_test(
    name = "protocol_gobco_test",
    go_mod = "go.mod",
    go_sum = "go.sum",
    tests = ["//internal/protocol:protocol_test"],
)

gobco_test(
    name = "relayclient_gobco_test",
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
    tests = ["//internal/relayclient:relayclient_test"],
)

gobco_test(
    name = "transport_gobco_test",
    go_mod = "go.mod",
    go_sum = "go.sum",
    proxy = "@go_mod_proxy//:proxy",
    tests = ["//internal/transport:transport_test"],
