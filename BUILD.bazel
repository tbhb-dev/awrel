# The changes file for a diff-scope mutation run: empty, so full scope,
# unless mutation_changes has written one.
filegroup(
    name = "mutation_changes",
    # buildifier: disable=constant-glob
    srcs = glob(
        [".mutation/changes.json"],
        allow_empty = True,
    ),
)

# Every file of the repository, for the whole-tree checks below. Each package
# calls repo_files() too, so the chain covers the tree. Directories that hold
# no source are ignored in REPO.bazel; these are the gitignored loose files
# that can sit in a working checkout.
repo_files(
    exclude = [
        "**/.DS_Store",
        ".bazelrc.user",
        ".coverage*",
        ".env*",
        ".mutation/**",
        ".claude/settings.local.json",
        ".github/PULL_REQUEST_DRAFT.md",
        "coverage.*",
        "mise.local.toml",
        # Synced Vale packages: only the project's own style is tracked.
        ".vale/Google/**",
        ".vale/write-good/**",
        ".vale/proselint/**",
        ".vale/ai-tells/**",
        ".vale/ai-tells-experimental/**",
        ".vale/config/scripts/**",
        ".vale/config/templates/**",
    ],
)

# The Worker's own npm packages, which the TypeScript checks read.
npm_link_all_packages(name = "node_modules")

# The Worker project: its sources, tests and tool configs. Every Worker
# target carries the "worker" tag: the Worker runs on Cloudflare's
# Linux-based runtime, so CI tests it on Linux only and skips the tag on the
# other operating systems.
WORKER = glob(["src/**"]) + [
    ".dependency-cruiser.cjs",
    "biome.json",
    "eslint.config.mjs",
    "knip.json",
    "package.json",
    "pnpm-workspace.yaml",
    "stryker.config.mjs",
    "tsconfig.json",
    "vitest.config.mjs",
    "worker-configuration.d.ts",
    "wrangler.jsonc",
]

# The handler's sources, for //e2e:check_test, which serves them from Node.
copy_to_bin(
    name = "worker_sources",
    srcs = glob(
        ["src/*.ts"],
        exclude = [
            "src/*.test.ts",
            "src/testing.ts",
        ],
    ),
    tags = ["worker"],
    visibility = ["//e2e:__pkg__"],
)

# The committed `Env` and runtime types, exactly what the pinned wrangler
# writes; `bazel run //:worker_types_test.update` regenerates them.
worker_types_test(
    name = "worker_types_test",
    srcs = WORKER,
    tags = ["worker"],
)

# `bazel run //:deploy_stg` (then prd) deploys the Worker and its Durable
# Object migrations: the new version runs //e2e:check at 0% through the
# version override, then again on the live URL after it takes all traffic.
# The workflow supplies the Cloudflare credentials, the GitHub App's webhook
# secret and the relay's connect token from 1Password; the check signs its
# test delivery with the secret and probes /connect with the token. Each environment's first deploy is a manual bootstrap.
WORKER_SECRETS = {
    "CONNECT_TOKEN": "CONNECT_TOKEN",
    "GITHUB_WEBHOOK_SECRET": "GITHUB_WEBHOOK_SECRET",
}

worker_deploy(
    name = "deploy_stg",
    srcs = WORKER,
    env = "stg",
    pass_env = [
        "CONNECT_TOKEN",
        "GITHUB_WEBHOOK_SECRET",
    ],
    post_deploy = ["//e2e:check"],
    pre_deploy = ["//e2e:check"],
    secrets = WORKER_SECRETS,
    tags = ["worker"],
    url = "https://awrel-stg.tbhb.dev",
)

worker_deploy(
    name = "deploy_prd",
    srcs = WORKER,
    env = "prd",
    pass_env = [
        "CONNECT_TOKEN",
        "GITHUB_WEBHOOK_SECRET",
    ],
    post_deploy = ["//e2e:check"],
    pre_deploy = ["//e2e:check"],
    secrets = WORKER_SECRETS,
    tags = ["worker"],
    url = "https://awrel.tbhb.dev",
)

# The TypeScript gates, each over a copy of the Worker project with its
# node_modules linked in. The type checks, the linters that read types and
