load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "awrel_lib",
    srcs = [
        "main.go",
        "mcp.go",
    ],
    importpath = "go.tbhb.dev/awrel/cmd/awrel",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/buildmeta",
        "//internal/mcpserver",
        "//internal/persist",
        "//internal/protocol",
        "//internal/relayclient",
        "//internal/transport",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "awrel",
    embed = [":awrel_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "awrel_test",
    srcs = [
        "main_internal_test.go",
        "mcp_internal_test.go",
        "persist_internal_test.go",
        "persist_store_internal_test.go",
    ],
    embed = [":awrel_lib"],
    # The whole-module Go checks in the root package take the tests too.
    visibility = ["//:__pkg__"],
    deps = [
        "//internal/mcpserver",
        "//internal/persist",
        "//internal/protocol",
        "@com_github_coder_websocket//:websocket",
        "@com_github_spf13_cobra//:cobra",
    ],
)
