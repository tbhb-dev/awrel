load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "mcpserver",
    srcs = ["mcpserver.go"],
    importpath = "go.tbhb.dev/awrel/internal/mcpserver",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/delivery",
        "//internal/protocol",
        "//internal/relayclient",
        "@com_github_modelcontextprotocol_go_sdk//jsonrpc",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)

go_test(
    name = "mcpserver_test",
    srcs = ["mcpserver_internal_test.go"],
    embed = [":mcpserver"],
    # The whole-module Go checks in the root package take the tests too.
    visibility = ["//:__pkg__"],
    deps = [
        "//internal/delivery",
        "//internal/protocol",
        "//internal/relayclient",
        "@com_github_modelcontextprotocol_go_sdk//jsonrpc",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)
