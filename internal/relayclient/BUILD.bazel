load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "relayclient",
    srcs = ["relayclient.go"],
    importpath = "go.tbhb.dev/awrel/internal/relayclient",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/protocol",
        "//internal/transport",
    ],
)

go_test(
    name = "relayclient_test",
    srcs = [
        "fakerelay_internal_test.go",
        "relayclient_internal_test.go",
    ],
    embed = [":relayclient"],
    # The whole-module Go checks in the root package take the tests too.
    visibility = ["//:__pkg__"],
    deps = [
        "//internal/protocol",
        "//internal/transport",
        "@com_github_coder_websocket//:websocket",
    ],
)
