// SPDX-License-Identifier: Apache-2.0
// Copyright Tony Burns
//
// The names, routes and custom domains here are the maintainers' own
// deployment. To run your own relay, replace them with yours, as
// docs/how-to/self-host.md describes.
//
// The Worker in each environment. The ops repository's OpenTofu owns the
// custom domains (awrel-stg.tbhb.dev and awrel.tbhb.dev), so wrangler
// manages no routes and serves nothing on workers.dev. RELAY is the
// SQLite-backed Durable Object that the Worker hands webhook events and MCP
// connections to; its migrations deploy with the script. CF_VERSION_METADATA
// gives the Worker its version id, which it returns on every response so the
// deploy's checks can tell which version answered. The top level, which
// deploys nowhere, is what the workerd tests run against.
{
  "name": "awrel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "env": {
    "stg": {
      "name": "awrel-stg",
      "workers_dev": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
      }
    },
    "prd": {
      "name": "awrel-prd",
      "workers_dev": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
      }
    }
  }
}
